   //pass by value (we pass value with an argument )
   #include <stdio.h>
      void cube(int a);
      int main() {
        int b = 3;
        cube(b);
        printf("cube of:%d\n", b);
        return 0;
      }
      void cube(int a) {
        a = a * a * a;
        printf("cube : %d\n", a);
      }

      //call by reference (we pass address of variable with an argument)
        #include <stdio.h>
      void cube(int a);  
      void _cube(int *a);
      int main() {
        //call by value
        int b = 3;
        cube(b);
        printf("%d\n", b); 
        //call by reference
        _cube(&b);
        printf("%d\n", b);
        return 0;
      }
      void cube(int a) {
        a = a * a * a;
        printf("%d", a);
      }
      void _cube(int *a) {
        *a = (*a) * (*a) * (*a);
        printf("%d\n", *a);
      }

// write a program  in function to find the number of odd numbers in an array.
      #include <stdio.h>
   void odd(int arr[], int n);
   int main() {
       int arr[] = {1, 2, 3, 4, 5, 6, 7, 8, 9};
       odd(arr, 9);
       return 0;
   }
   void odd(int arr[], int n) {
       int count = 0;
        for(int i = 0; i < n; i++) {
            if(arr[i] %2 != 0) { 
            count++; //increment if the counter is odd
            }
            }
        printf("total odd numbers: %d\n", count);
   }
    

